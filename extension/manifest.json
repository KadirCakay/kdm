{
  "manifest_version": 3,
  "name": "KDM Yakalayıcı",
  "version": "1.0.0",
  "description": "Sayfalardaki video, akış (HLS/DASH) ve altyazıları yakalayıp KDM indirme yöneticisine gönderir.",
  "permissions": ["webRequest", "cookies", "storage", "contextMenus", "tabs", "downloads", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KDM",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "kdm-yakalayici@local", "strict_min_version": "121.0" }
  }
}
